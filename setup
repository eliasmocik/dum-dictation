#!/usr/bin/env bash
# setup - one command to make a freshly-cloned checkout runnable.
#
#   ./setup
#
# Creates .venv, installs pinned deps, downloads the Parakeet speech model and
# pre-pulls the on-device correction LLM, then prints the macOS permissions you
# must grant. After it finishes, run ./dum.
#
# macOS (Apple Silicon) or Linux; Windows uses setup.ps1. Works with any CPython in
# $PY_SUPPORTED below - and if the machine has none, setup fetches its own into ./.python
# rather than dead-ending on a version mismatch.
set -euo pipefail
cd "$(dirname "$0")"

PY=.venv/bin/python
PARAKEET_DIR="models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"
PARAKEET_TARBALL="sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8.tar.bz2"
PARAKEET_URL="https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/${PARAKEET_TARBALL}"
LLM_MODEL="mlx-community/Llama-3.2-1B-Instruct-4bit"

# macOS support is Apple Silicon only: the correction LLM (mlx-lm) and several pins ship
# no Intel-mac wheels, so an Intel/Rosetta run would fail deep into the install. Fail fast.
if [ "$(uname)" = "Darwin" ] && [ "$(uname -m)" != "arm64" ]; then
  echo "[!] On macOS, dum needs Apple Silicon (M-series). Intel Macs aren't supported"
  echo "    (the speech + correction models ship Apple-Silicon-only wheels)."
  exit 1
fi

echo "==> 1/5  Python venv + pinned dependencies"
# Which CPython minors we support. Every pin in requirements.txt publishes wheels for all
# of these (sherpa-onnx / numpy / rapidfuzz / jellyfish / pillow / pyobjc ship cp312+cp313+
# cp314; llama-cpp-python's prebuilt wheel is py3-none, i.e. ABI-independent). This list is
# the source of truth - KEEP IT IN SYNC with the matrix in .github/workflows/tests.yml,
# which is what actually PROVES a minor is safe. Wheel availability alone is not proof.
PY_SUPPORTED="3.12 3.13 3.14"
# The interpreter we vendor when the machine has no supported Python, so ./setup can never
# dead-end on "your python is the wrong version" (the #1 fresh-machine failure after the
# llama-cpp source build). python-build-standalone is the same relocatable CPython that uv
# ships; pinned by release tag + sha256 so the download is reproducible and verified.
PBS_TAG=20260718
PBS_PY=3.12.13
VENDOR_ROOT=".python"
VENDOR_PY="$VENDOR_ROOT/python/bin/python3"

py_minor() { "$1" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true; }
py_supported() {
  local v
  v="$(py_minor "$1")"
  [ -n "$v" ] || return 1
  case " $PY_SUPPORTED " in (*" $v "*) ;; (*) return 1 ;; esac
  # Debian/Ubuntu split the venv module into a separate python3.X-venv package, so a Python
  # can be the right VERSION and still be unable to build a usable venv. Reject those here
  # rather than half-building a pip-less .venv - the caller then falls through to vendoring.
  "$1" -c 'import ensurepip, venv' >/dev/null 2>&1 || return 1
  return 0
}
sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else openssl dgst -sha256 "$1" | awk '{print $NF}'; fi
}

# Download a known-good CPython into the repo. Touches nothing outside this folder, needs
# no sudo, and never edits the user's shell profile or PATH.
vendor_python() {
  local triple variant sha url tarball got
  case "$(uname -s):$(uname -m)" in
    Darwin:arm64)  triple=aarch64-apple-darwin;  variant=install_only
      sha=62aeee6161d57303a71a138b75fd5cc6fb8c89c4b1d9c7f0a052d89fa0b6652b ;;
    Darwin:x86_64) triple=x86_64-apple-darwin;   variant=install_only
      sha=10b47148de86f9d87ba6e96a3db606ced90a206a3454d7d6d8fa68536a05d81f ;;
    Linux:x86_64)  triple=x86_64-unknown-linux-gnu;  variant=install_only_stripped
      sha=5854aa6ec71cad00334d5065633c210b2e7feb40956767a59a91791cadcf0b79 ;;
    Linux:aarch64|Linux:arm64) triple=aarch64-unknown-linux-gnu; variant=install_only_stripped
      sha=f226576b91491ffa5739aa85726521e9031f4d87f80627d64ed348ac77cb31e9 ;;
    *) echo "    [!] no prebuilt CPython for $(uname -s)/$(uname -m)."; return 1 ;;
  esac
  # The Linux builds link glibc; musl systems (Alpine) must supply their own Python.
  if [ "$(uname -s)" = "Linux" ] && ls /lib/ld-musl-* >/dev/null 2>&1; then
    echo "    [!] musl libc detected - the prebuilt CPython is glibc-only."
    return 1
  fi
  tarball="cpython-${PBS_PY}+${PBS_TAG}-${triple}-${variant}.tar.gz"
  url="https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_TAG}/${tarball}"
  mkdir -p "$VENDOR_ROOT"
  echo "    downloading CPython $PBS_PY for $triple (~25 MB) ..."
  # --connect-timeout: curl's default is 300s, so a blackholed route (captive portal, corporate
  # firewall) makes setup look hung for 5 minutes before the friendly message below.
  # --speed-limit/--speed-time: bail if the transfer stalls under 1 KB/s for 60s. NOT --max-time,
  # which would also kill a legitimately slow download on a thin connection.
  curl -L --fail --connect-timeout 20 --retry 2 --speed-limit 1024 --speed-time 60 \
       -o "$VENDOR_ROOT/$tarball" "$url" || {
    echo "    [!] download failed - check your network. URL was:"
    echo "        $url"
    return 1
  }
  got="$(sha256_of "$VENDOR_ROOT/$tarball")"
  if [ "$got" != "$sha" ]; then
    echo "    [!] checksum mismatch on $tarball - refusing to use it."
    echo "        expected $sha"
    echo "        got      $got"
    rm -f "$VENDOR_ROOT/$tarball"
    return 1
  fi
  # Wipe any earlier vendored tree first: tar MERGES over an existing dir, so a leftover
  # lib/python3.X/ from a different pin would linger next to the new one.
  rm -rf "$VENDOR_ROOT/python"
  tar -xzf "$VENDOR_ROOT/$tarball" -C "$VENDOR_ROOT" || {
    echo "    [!] extract failed (corrupt download?) - clean up and re-run:"
    echo "        rm -rf $VENDOR_ROOT && ./setup"
    return 1
  }
  rm -f "$VENDOR_ROOT/$tarball"
  [ -x "$VENDOR_PY" ] || { echo "    [!] vendored CPython missing $VENDOR_PY"; return 1; }
  return 0
}

# A .venv whose interpreter no longer runs (repo moved/renamed, or the system Python it was
# built from was upgraded away) is worse than no venv - every later step fails obscurely.
if [ -e .venv ] && [ -z "$(py_minor "$PY")" ]; then
  echo "    [!] .venv exists but its Python no longer runs (repo moved, or the Python it was"
  echo "        built from was removed/upgraded). Rebuild it:"
  echo "        rm -rf .venv && ./setup"
  exit 1
fi

if [ ! -x "$PY" ]; then
  # Prefer, in order: an already-vendored CPython, then any supported system Python (probed
  # OLDEST-first - 3.12 is the best-tested pin, so it wins when several are installed), then
  # vendor one.
  PYBIN=""
  if [ -x "$VENDOR_PY" ] && py_supported "$VENDOR_PY"; then
    PYBIN="$VENDOR_PY"
  else
    for cand in python3.12 python3.13 python3.14 python3; do
      found="$(command -v "$cand" || true)"
      if [ -n "$found" ] && py_supported "$found"; then PYBIN="$found"; break; fi
    done
  fi
  if [ -z "$PYBIN" ]; then
    echo "    no supported Python found on this machine (need one of: $PY_SUPPORTED)."
    echo "    fetching a private copy into ./$VENDOR_ROOT - your system Python is left alone."
    if vendor_python; then
      PYBIN="$VENDOR_PY"
    else
      echo "    [!] couldn't vendor a Python, and none of $PY_SUPPORTED is installed."
      echo "        Install one yourself, then re-run ./setup:"
      echo "        macOS:  brew install python@3.12"
      echo "        Linux:  sudo apt install python3.12 python3.12-venv  (or your distro's equivalent)"
      exit 1
    fi
  fi
  echo "    creating .venv with $PYBIN ($("$PYBIN" -V 2>&1))"
  # The ensurepip/venv probe in py_supported() catches the common Debian case, but a Python
  # can still pass it and fail to actually BUILD a venv (distro-stripped ensurepip._bundled
  # wheels, a broken bundled pip). Don't dead-end there - that's the whole promise of this
  # block - fall back to vendoring, unless the vendored copy is what just failed.
  if ! "$PYBIN" -m venv .venv; then
    rm -rf .venv
    if [ "$PYBIN" != "$VENDOR_PY" ]; then
      echo "    [!] $PYBIN couldn't build a venv (see the error above) - falling back to a"
      echo "        private copy of Python; your system one is left alone."
      # Keep these two failures separate: "couldn't download" and "downloaded but can't build
      # a venv" need completely different advice, and telling an offline user to delete and
      # retry just loops them through the same failure.
      if ! vendor_python; then
        echo "    [!] couldn't fetch a private Python either (see the error above)."
        echo "        Install a supported Python yourself, then re-run ./setup:"
        echo "        macOS:  brew install python@3.12"
        echo "        Linux:  sudo apt install python3.12 python3.12-venv  (or your distro's equivalent)"
        exit 1
      fi
      if ! "$VENDOR_PY" -m venv .venv; then
        echo "    [!] the vendored Python couldn't build a venv either. Clean up and retry:"
        echo "        rm -rf .venv $VENDOR_ROOT && ./setup"
        exit 1
      fi
    else
      echo "    [!] the vendored Python couldn't build a venv (see the error above)."
      echo "        Clean up and retry:  rm -rf .venv $VENDOR_ROOT && ./setup"
      exit 1
    fi
  fi
elif ! py_supported "$PY"; then
  echo "    [!] .venv is $("$PY" -V 2>&1), which isn't supported (need one of: $PY_SUPPORTED)."
  echo "        rm -rf .venv && ./setup"
  exit 1
fi
"$PY" -m pip install --upgrade pip >/dev/null || {
  echo "    [!] this .venv has no working pip (a partial venv). Rebuild it - setup will fall"
  echo "        back to vendoring its own Python if your system one can't build a venv:"
  echo "        rm -rf .venv && ./setup"
  exit 1
}
# llama-cpp-python (the portable homophone-LLM backend) is SOURCE-ONLY on PyPI - a plain
# `-r requirements.txt` tries to compile it, which needs cmake + a C++ toolchain and is the
# #1 fresh-machine failure. Install it FIRST from the maintainer's prebuilt wheel index so
# the `-r` step below finds the pin already satisfied and never builds from source.
# Metal (Apple GPU) wheels on Apple Silicon, CPU wheels everywhere else.
if [ "$(uname)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ]; then
  LLAMA_INDEX="https://abetlen.github.io/llama-cpp-python/whl/metal"
else
  LLAMA_INDEX="https://abetlen.github.io/llama-cpp-python/whl/cpu"
fi
echo "    installing llama-cpp-python==0.3.30 from prebuilt index ($LLAMA_INDEX)"
# --only-binary bars pip from EVER falling back to the PyPI source build (which is the whole
# failure we're avoiding): if no wheel matches this platform, it fails fast with a clear
# "no matching distribution" instead of a 20-minute compile that then errors out.
"$PY" -m pip install "llama-cpp-python==0.3.30" --only-binary=llama-cpp-python --extra-index-url "$LLAMA_INDEX" || {
  echo "    [!] no prebuilt llama-cpp-python wheel installed - either the wheel index was"
  echo "        unreachable (check your network) or there's no wheel for your platform."
  echo "        manual retry:  $PY -m pip install 'llama-cpp-python==0.3.30' --only-binary=llama-cpp-python --extra-index-url $LLAMA_INDEX"
  exit 1
}
"$PY" -m pip install -r requirements.txt || {
  echo "    [!] dependency install failed - scroll up for pip's actual error, fix it, then re-run ./setup"
  exit 1
}

echo ""
echo "==> 2/5  Parakeet speech model"
if [ -f "$PARAKEET_DIR/encoder.int8.onnx" ] && [ -f "$PARAKEET_DIR/tokens.txt" ]; then
  echo "    already present at $PARAKEET_DIR - skipping download"
else
  mkdir -p models
  echo "    downloading $PARAKEET_TARBALL (~480 MB) ..."
  curl -L --fail --connect-timeout 20 --retry 2 --speed-limit 1024 --speed-time 60 \
       -o "models/$PARAKEET_TARBALL" "$PARAKEET_URL" || {
    echo "    [!] model download failed - check your network, then re-run ./setup"
    exit 1
  }
  echo "    extracting ..."
  tar -xjf "models/$PARAKEET_TARBALL" -C models || {
    echo "    [!] extract failed (corrupt download?) - clean up and re-run:"
    echo "        rm -f models/$PARAKEET_TARBALL && ./setup"
    exit 1
  }
  rm -f "models/$PARAKEET_TARBALL"
fi
# Verify the layout find_model_dir() expects.
missing=0
for f in encoder.int8.onnx decoder.int8.onnx joiner.int8.onnx tokens.txt; do
  if [ ! -f "$PARAKEET_DIR/$f" ]; then echo "    [!] missing $PARAKEET_DIR/$f"; missing=1; fi
done
if [ "$missing" -ne 0 ]; then echo "    [!] Parakeet model is incomplete - re-run ./setup"; exit 1; fi
echo "    ok: 3 .onnx files + tokens.txt in $PARAKEET_DIR"

echo ""
echo "==> 3/5  Pre-pull the on-device correction LLM ($LLM_MODEL)"
if [ "$(uname)" = "Darwin" ]; then
  echo "    (avoids a multi-hundred-MB surprise download on first dictation)"
  # Call the library, NOT .venv/bin/hf: console scripts bake an ABSOLUTE shebang at install
  # time, so renaming or moving the checkout breaks them ("bad interpreter") while the venv
  # itself still works. `$PY -m`-style invocation is immune, and that matters more now that
  # a vendored interpreter lives inside the repo.
  "$PY" -c "from huggingface_hub import snapshot_download; snapshot_download('$LLM_MODEL')" >/dev/null || {
    echo "    [!] LLM pre-pull failed - check your network, then re-run ./setup"
    echo "        (or skip for now: it also downloads on first --llm dictation)"
    exit 1
  }
  echo "    ok"
else
  echo "    skipped - the MLX homophone LLM is Apple-Silicon only; this OS runs without it."
fi

echo ""
if [ "$(uname)" = "Darwin" ]; then
  echo "==> 4/5  macOS permissions (grant these to your TERMINAL app, then relaunch it)"
  cat <<'PERMS'
    System Settings > Privacy & Security, grant to your terminal app:
      1. Microphone        - to capture your voice
      2. Accessibility     - to type/paste text into the focused app
      3. Input Monitoring  - to detect the double-tap left Command hotkey
    Then QUIT and reopen the terminal so the grants take effect.
PERMS
else
  echo "==> 4/5  Linux setup (X11)"
  cat <<'PERMS'
    Install the typing/clipboard tools if you haven't:  xdotool  xclip   (or wl-clipboard on Wayland)
      e.g.  sudo apt install xdotool xclip
    Make sure your user can use the microphone (PulseAudio/PipeWire) - usually already fine.
    Default hotkey: double-tap RIGHT Ctrl (change it with ./dum --config).
PERMS
fi

echo ""
echo "==> 5/5  Import sanity check (dependencies + the engine itself)"
# mlx_lm is imported only on macOS - it's an Apple-Silicon wheel and is marked darwin-only in
# requirements.txt, so it isn't installed elsewhere (the LLM stage is lazy + gated regardless).
"$PY" -c "import sys, sherpa_onnx, sounddevice, pynput, pystray, llama_cpp
if sys.platform == 'darwin':
    import mlx_lm
print('    ok: dependencies import')" || {
  echo "    [!] dependency import failed (see traceback above) - re-run ./setup;"
  echo "        if it keeps failing:  rm -rf .venv && ./setup"
  exit 1
}
# Also import the engine (src/ on the path) so a broken layout fails HERE, with a clear
# message, instead of at first dictation.
PYTHONPATH="$PWD/src" "$PY" -c "import live, pipeline, overlay, config, platform_io; print('    ok: engine imports')" || {
  echo "    [!] engine import failed (see traceback above) - your checkout may be incomplete;"
  echo "        make sure src/ is intact, then re-run ./setup"
  exit 1
}

# Route git hooks through the tracked .githooks/ dir (keeps commit messages tool-agnostic).
git config core.hooksPath .githooks 2>/dev/null || true

echo ""
echo "Done. Now run:  ./dum"
echo "(double-tap the LEFT Command key to start/stop dictation)"
