# Python env + caches
.venv/
# Vendored CPython (~66 MB), fetched by ./setup only when the machine has no supported Python.
.python/
# uv, fetched by ./setup only when it needs to vendor a CPython and uv isn't already on PATH.
# Disposable like .venv/ and .python/ - never committed.
.uv/
__pycache__/
*.pyc

# Local editor settings (machine-specific; may reference private extensions/paths)
.vscode/

# macOS
.DS_Store

# Generated locally by make-shortcut.ps1 (the Desktop icon image)
dum.ico

# Models - downloaded by ./setup, never committed (large)
models/

# Local-only dictation history + telemetry (your voice/text - never committed)
dogfood/
sessions/
recordings/
*.jsonl

# Recorded audio + bench replay artifacts
*.wav
tests/corpus/
tests/.bench-out/

# Bench/analysis outputs
results/

# Secrets
.env
*.env

# Release build output (scripts/build-app, scripts/release). Two reasons this must never be
# committed: the .app/.dmg are large regenerable binaries, and dist/cert/ will hold the
# SELF-SIGNED CODE-SIGNING PRIVATE KEY. This repo is PUBLIC. That key is what makes macOS treat
# a binary as "the same app" and hand it users' existing Microphone / Accessibility / Input
# Monitoring grants - leaking it would let anyone inherit those permissions.
dist/
build/
*.dmg
*.p12
*.key
*.crt

# Local-only notes / scratch context (never committed)
*.local.md

# Local demo-recording driver (never ship - would look like a faked demo)
demo_local/

# Personal demo recordings / raw clips (local only - not for the public repo)
docs/demo2vids/
docs/*.mp4
docs/*.mov
